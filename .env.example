# ATLAS Lean — environment template
# Copy to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env

# --- Anthropic (required for live mode + weekly review) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Telegram ---
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Your numeric chat ID. REQUIRED: commands are rejected while this is 0,
# so an unconfigured bot cannot be driven by an arbitrary Telegram user.
TELEGRAM_CHAT_ID=0

# --- Binance (optional: public endpoints need no key) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Trading mode ---
# SPOT = capital-constrained, 30% allocation cap, 3% min stop
# FUTURES = risk-first, exact 2% risk per trade
TRADING_MODE=SPOT
FUTURES_LEVERAGE=3
