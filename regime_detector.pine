//@version=6
indicator("ATLAS Lean Regime Detector", overlay=true, max_bars_back=500)

// ═══════════════════════════════════════════════════════════════════════════
// ATLAS Lean v2.0 — Regime Detector for TradingView (Pine Script v6)
// Matches exact backtest logic (backtest.py detect_regime_bar)
//
// Green  bg = PULLBACK  (dip buy in uptrend)
// Blue   bg = TRENDING  (momentum ride)
// Gray   bg = RANGING   (no valid setup — stay out)
// ═══════════════════════════════════════════════════════════════════════════

// ─── Inputs ──────────────────────────────────────────────────────────────────

const string G_MA   = "Moving Averages"
const string G_RSI  = "RSI"
const string G_BB   = "Bollinger Bands"
const string G_ATR  = "ATR"
const string G_ADX  = "ADX & Choppiness"
const string G_DAY  = "Daily Macro Filter"
const string G_DISP = "Display"

ema50_len      = input.int(50,    "EMA50 Length",                  group=G_MA)
ema200_len     = input.int(200,   "EMA200 Length",                 group=G_MA)

rsi_len        = input.int(14,    "RSI Length",                    group=G_RSI)
rsi_pb_min     = input.int(28,    "Pullback RSI Min",              group=G_RSI)
rsi_pb_max     = input.int(55,    "Pullback RSI Max",              group=G_RSI)
rsi_trend_min  = input.int(50,    "Trending RSI Min",              group=G_RSI)
rsi_trend_max  = input.int(75,    "Trending RSI Max",              group=G_RSI)

bb_len         = input.int(20,    "BB Length",                     group=G_BB)
bb_mult        = input.float(2.0, "BB Multiplier",                 group=G_BB)
bb_pb_thresh   = input.float(0.40,"BB %B Threshold (Pullback < X)",group=G_BB)

atr_len        = input.int(14,    "ATR Length",                    group=G_ATR)
atr_sma_len    = input.int(20,    "ATR SMA Length",                group=G_ATR)

adx_len        = input.int(14,    "ADX Length",                    group=G_ADX)
adx_pb_max     = input.float(25.0,"ADX < X -> Pullback valid",     group=G_ADX)
adx_trend_min  = input.float(25.0,"ADX > X -> Trending valid",     group=G_ADX)
chop_len       = input.int(14,    "CHOP Length",                   group=G_ADX)
chop_pb_min    = input.float(55.0,"CHOP > X -> Pullback valid",    group=G_ADX)
chop_trend_max = input.float(38.2,"CHOP < X -> Trending valid",    group=G_ADX)

use_daily      = input.bool(true, "Enable Daily EMA Filter",       group=G_DAY)
d_ema21_len    = input.int(21,    "Daily EMA21 Length",            group=G_DAY)
d_ema50_len    = input.int(50,    "Daily EMA50 Length",            group=G_DAY)

show_emas      = input.bool(true,  "Show EMA50 / EMA200",          group=G_DISP)
show_bb        = input.bool(true,  "Show Bollinger Bands",         group=G_DISP)
show_bgcolor   = input.bool(true,  "Show Regime Background",       group=G_DISP)
show_signals   = input.bool(true,  "Show Entry Signals",           group=G_DISP)
show_table     = input.bool(true,  "Show Summary Table",           group=G_DISP)

// ─── Indicators ───────────────────────────────────────────────────────────────

float ema50  = ta.ema(close, ema50_len)
float ema200 = ta.ema(close, ema200_len)
float rsi    = ta.rsi(close, rsi_len)

// Bollinger Bands %B
float bb_mid   = ta.sma(close, bb_len)
float bb_dev   = ta.stdev(close, bb_len)
float bb_upper = bb_mid + bb_mult * bb_dev
float bb_lower = bb_mid - bb_mult * bb_dev
float bb_pctb  = (close - bb_lower) / (bb_upper - bb_lower)

// ATR & its SMA
float atr_val = ta.atr(atr_len)
float atr_sma = ta.sma(atr_val, atr_sma_len)

// ADX — manual implementation (ta.adx removed in Pine v6)
f_adx(length) =>
    float up       = ta.change(high)
    float down     = -ta.change(low)
    float plus_dm  = na(up)   ? na : (up   > down and up   > 0.0 ? up   : 0.0)
    float minus_dm = na(down) ? na : (down > up   and down > 0.0 ? down : 0.0)
    float tr       = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
    float atr14    = ta.rma(tr, length)
    float plus_di  = 100.0 * ta.rma(plus_dm, length) / math.max(atr14, 1e-10)
    float minus_di = 100.0 * ta.rma(minus_dm, length) / math.max(atr14, 1e-10)
    float dx       = 100.0 * math.abs(plus_di - minus_di) / math.max(plus_di + minus_di, 1e-10)
    float adx      = ta.rma(dx, length)
    adx

float adx_val = f_adx(adx_len)

// Choppiness Index — ta.sum() removed in Pine v6; use sma * length instead
float chop_hl     = ta.highest(high, chop_len) - ta.lowest(low, chop_len)
float chop_atrsum = ta.sma(ta.atr(1), chop_len) * chop_len
float chop_val    = 100.0 * math.log10(chop_atrsum / math.max(chop_hl, 1e-10)) / math.log10(chop_len)

// Daily EMAs — lookahead off to avoid future leak
float d_ema21 = request.security(syminfo.tickerid, "D", ta.ema(close, d_ema21_len), lookahead=barmerge.lookahead_off)
float d_ema50 = request.security(syminfo.tickerid, "D", ta.ema(close, d_ema50_len), lookahead=barmerge.lookahead_off)
float d_close = request.security(syminfo.tickerid, "D", close,                       lookahead=barmerge.lookahead_off)

bool macro_ok = d_close > d_ema21 and d_ema21 > d_ema50

// ─── Regime Logic ─────────────────────────────────────────────────────────────

// PULLBACK: dip buy in confirmed uptrend
//   price > EMA200, within 2.5% of EMA50
//   RSI 28-55, BB%B < 0.40
//   ADX < 25 (not strongly directional), CHOP > 55 (consolidating)
//   Daily: close > EMA21 > EMA50

bool pullback_struct = close > ema200
                     and math.abs(close - ema50) / ema50 < 0.025
                     and rsi >= rsi_pb_min and rsi <= rsi_pb_max
                     and bb_pctb < bb_pb_thresh
                     and adx_val < adx_pb_max
                     and chop_val > chop_pb_min

bool is_pullback = pullback_struct and (not use_daily or macro_ok)

// TRENDING: ride strong directional momentum
//   price > EMA50 & EMA200, RSI 50-75
//   ATR expanding, ADX > 25, CHOP < 38.2

bool trending_struct = close > ema50
                      and close > ema200
                      and rsi >= rsi_trend_min and rsi <= rsi_trend_max
                      and atr_val >= atr_sma
                      and adx_val > adx_trend_min
                      and chop_val < chop_trend_max

// TRENDING disabled — 0% win rate in backtest (peak-chasing at exhaustion tops)
// Kept here for reference; is_trending is never used to trigger an entry signal
bool is_trending = false  // trending_struct and (not use_daily or macro_ok)

// RANGE_LONG: mean-reversion buy at lower BB in a confirmed colocated range
// Strict Fibonacci thresholds (ADX < 20, CHOP > 61.8) — only fires in genuine ranges
// No daily macro filter needed: "not in freefall" guard covers catastrophic drops
bool adx_range_strict  = adx_val  < 20     // Fibonacci lower: weak trend
bool chop_range_strict = chop_val > 61.8   // Fibonacci upper: strongly choppy
bool near_lower_bb     = bb_pctb  < 0.20   // bottom 20% of Bollinger Band
bool rsi_range_buy     = rsi < 45          // oversold in range context
bool not_freefall      = close > ema200 * 0.85  // block only catastrophic crash

bool is_range_long = adx_range_strict and chop_range_strict and
                     near_lower_bb and rsi_range_buy and not_freefall

// RANGING: default — no setup found
bool is_ranging = not is_pullback and not is_trending and not is_range_long

// ─── Background ───────────────────────────────────────────────────────────────

color bg_color = is_pullback   ? color.new(color.green,  85) :
                 is_trending   ? color.new(color.blue,   85) :
                 is_range_long ? color.new(color.orange, 85) :
                                 color.new(color.gray,   93)

bgcolor(show_bgcolor ? bg_color : na, title="Regime Background")

// ─── Bollinger Bands ──────────────────────────────────────────────────────────

color bb_col = is_range_long ? color.new(color.orange, 30) : color.new(color.gray, 65)

p_bb_upper = plot(show_bb ? bb_upper : na, title="BB Upper", color=bb_col, linewidth=1)
             plot(show_bb ? bb_mid   : na, title="BB Mid",   color=color.new(color.gray, 55), linewidth=1, style=plot.style_circles)
p_bb_lower = plot(show_bb ? bb_lower : na, title="BB Lower", color=bb_col, linewidth=1)
fill(p_bb_upper, p_bb_lower,
     color = is_range_long ? color.new(color.orange, 92) :
             is_pullback   ? color.new(color.green,  95) :
                             color.new(color.gray,   97),
     title = "BB Fill")

// TP target: BB midline shown as dashed line during RANGE_LONG (the mean-reversion target)
plot(is_range_long ? bb_mid : na, title="Range TP (BB Mid)", color=color.new(color.orange, 0), linewidth=2, style=plot.style_linebr)

// ─── MAs ──────────────────────────────────────────────────────────────────────

plot(show_emas ? ema50  : na, title="EMA50",  color=color.orange, linewidth=2)
plot(show_emas ? ema200 : na, title="EMA200", color=color.red,    linewidth=2)

// ─── Entry Signals ────────────────────────────────────────────────────────────

bool pb_start         = is_pullback   and not is_pullback[1]
bool trend_start      = is_trending   and not is_trending[1]
bool range_long_start = is_range_long and not is_range_long[1]

plotshape(show_signals and pb_start,         title="PULLBACK Entry",   style=shape.triangleup, location=location.belowbar, color=color.green,  size=size.small)
plotshape(show_signals and trend_start,      title="TRENDING Entry",   style=shape.triangleup, location=location.belowbar, color=color.blue,   size=size.small)
plotshape(show_signals and range_long_start, title="RANGE_LONG Entry", style=shape.triangleup, location=location.belowbar, color=color.orange, size=size.small)

// ─── Summary Table ────────────────────────────────────────────────────────────

var table t = table.new(position.top_right, 2, 8,
     bgcolor       = color.new(color.black, 70),
     border_color  = color.new(color.gray,  50),
     border_width  = 1,
     frame_color   = color.gray,
     frame_width   = 1)

if barstate.islast and show_table
    string regime_str = is_pullback   ? "PULLBACK"   :
                        is_trending   ? "TRENDING"   :
                        is_range_long ? "RANGE_LONG" : "RANGING"
    color  regime_col = is_pullback   ? color.green  :
                        is_trending   ? color.blue   :
                        is_range_long ? color.orange : color.gray

    table.cell(t, 0, 0, "ATLAS Regime", bgcolor=color.new(color.black, 60), text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 0, regime_str,      bgcolor=color.new(regime_col,  50), text_color=color.white,  text_size=size.small)

    table.cell(t, 0, 1, "RSI(14)",      text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(rsi, "#.1") + "  [28-55 / 50-75]",
         text_color = rsi >= 28 and rsi <= 75 ? color.green : color.red,
         text_size  = size.small)

    table.cell(t, 0, 2, "ADX(14)",      text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(adx_val, "#.1") + "  [<25 or >25]",
         text_color = adx_val > 20 ? color.green : color.orange,
         text_size  = size.small)

    table.cell(t, 0, 3, "CHOP(14)",     text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(chop_val, "#.1") + "  [<38.2 or >55]",
         text_color = chop_val < 61.8 ? color.green : color.orange,
         text_size  = size.small)

    table.cell(t, 0, 4, "BB %B",        text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 4, str.tostring(bb_pctb, "#.2") + "  [<0.40 pb]",
         text_color = bb_pctb < 0.4 ? color.green : color.silver,
         text_size  = size.small)

    table.cell(t, 0, 5, "ATR/SMA",      text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 5, str.tostring(atr_val / atr_sma, "#.2") + "x",
         text_color = atr_val >= atr_sma ? color.green : color.silver,
         text_size  = size.small)

    table.cell(t, 0, 6, "Daily Filter", text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 6, macro_ok ? "OK (bullish)" : "BLOCKED",
         text_color = macro_ok ? color.green : color.red,
         text_size  = size.small)

    float ema50_dist = (close - ema50) / ema50 * 100.0
    table.cell(t, 0, 7, "Dist EMA50",   text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 7, str.tostring(ema50_dist, "#.2") + "%  [+/-2.5%]",
         text_color = math.abs(ema50_dist) < 2.5 ? color.green : color.silver,
         text_size  = size.small)
